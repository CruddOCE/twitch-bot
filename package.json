{
  "name": "twitch-bot",
  "version": "0.7.0",
  "private": true,
  "description": "Local Twitch live chat bot with custom commands and auto-moderation",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "build-installer": "node scripts/build-installer.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "obs-source": "node scripts/addObsSource.js",
    "obs-refresh": "node scripts/refreshObsSource.js",
    "channel-read": "node scripts/readChannelInfo.js",
    "channel-set": "node scripts/setChannelInfo.js",
    "channel-stats": "node scripts/readChannelStats.js",
    "start": "node index.js",
    "test": "node test/run.js",
    "twitch-auth": "node scripts/getTwitchToken.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tmi.js": "^1.8.5",
    "ws": "^8.17.0"
  }
}
