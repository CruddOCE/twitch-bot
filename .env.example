# Copy this file to .env and fill in the values below.
# Never commit your real .env file.

# --- General ---
BOT_PREFIX=!
# Port for the local alert/overlay server (add http://localhost:<port>/overlay.html
# as an OBS Browser Source)
ALERT_SERVER_PORT=8090

# --- Twitch ---
# The Twitch account the bot logs in as (must be modded in your channel
# for timeout/ban/delete actions to work: /mod <botname> in your own chat)
TWITCH_BOT_USERNAME=
# Chat token in the form oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get one by running: npm run twitch-auth
# Includes channel:manage:broadcast (needed for !title/!game) -- Twitch
# only allows a channel's own token to change its info, so !title/!game
# only work when TWITCH_BOT_USERNAME is the broadcaster's own account.
TWITCH_OAUTH_TOKEN=
# Your channel name (the channel the bot joins), lowercase, no #
TWITCH_CHANNEL=

# Leave blank to use the built-in shared Twitch app (no app to register --
# npm run setup / npm run twitch-auth just have you sign in). Only set this
# if you want your own app instead (register one at
# https://dev.twitch.tv/console/apps, OAuth Redirect URL
# http://localhost:3940/callback).
TWITCH_CLIENT_ID=
# Only needed for !so's optional "last streaming <game>" lookup. Requires
# your OWN Twitch app (Client ID above + a Client Secret from the same
# app's page) -- the built-in shared app doesn't include a secret, so this
# extra isn't available unless you register your own app. Without it, !so
# still works, just without the "last streaming <game>" part.
TWITCH_CLIENT_SECRET=

# --- OBS (optional) ---
# Only needed if you use `npm run obs-source` to auto-add the overlay to OBS.
# Leave blank if your OBS WebSocket server has no password set.
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
